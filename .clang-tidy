# SuperGenius clang-tidy configuration
#
# Encodes rules from:
#   - CLAUDE.md → SuperGenius Naming Convention Overrides (takes precedence)
#   - Software Engineering Handbook → C++ Coding Standards (baseline)
#     https://docs.gnus.ai/technical-information/software-engineering-handbook/c++-coding-standards/
#
# Each check maps to a specific Handbook rule.
#   [Required]  = Handbook "Standard" the code already follows; should pass clean.
#   [Recommended] = Handbook "Guideline" or target the code is converging on;
#                    warnings are expected on some files.
#
# Run: clang-tidy <file> -- -std=c++17
#
# ─────────────────────────────────────────────────────────────
# The checks are organized in groups:
#   1. Bug detection & security         [Required]
#   2. CERT security coding standards   [Required]
#   3. Core guidelines code follows     [Required]
#   4. Modernization                    [Recommended]
#   5. Readability & simplification     [Recommended]
#   6. Performance                      [Recommended]
#   7. Miscellaneous safety             [Recommended]
#   8. Naming conventions               [Recommended]
# ─────────────────────────────────────────────────────────────
#
# Handbook rule mapping:
#   Standard 11 → readability-braces-around-statements
#   Standard 14 → enum constants casing (see CheckOptions)
#   Standard 15 → cppcoreguidelines-init-variables,
#                 cppcoreguidelines-pro-type-member-init,
#                 readability-redundant-member-init
#   Guideline 24 → cppcoreguidelines-avoid-goto
#   Guideline 27 → readability-implicit-bool-conversion
#   Standards 36–47 → readability-identifier-naming (see CheckOptions)
#   Standard 40 → m_ member prefix (see CheckOptions)
#   Standard 51 → google-readability-casting
#   Standard 56 (modified) → modernize-use-nullptr
#   Standard 63 (modified) → cppcoreguidelines-special-member-functions
#   Standard 64 → (covered by bugprone-* virtual-destructor)
#   Standard 75 → misc-non-private-member-variables-in-classes
#   Standard 92 → modernize-use-override
#   Standard 101 → readability-make-member-function-const
#   CLAUDE.md → cppcoreguidelines-avoid-magic-numbers (allow 0,1,-1,2)
#   CLAUDE.md → cppcoreguidelines-prefer-member-initializer
#   CLAUDE.md → modernize-use-noexcept

Checks: >
  boost-*,
  -boost-use-ranges,

  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,

  concurrency-*,

  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-special-member-functions,

  google-build-explicit-make-pair,
  google-build-namespaces,
  google-default-arguments,
  google-global-names-in-headers,
  google-readability-avoid-underscore-in-googletest-name,
  google-readability-casting,
  google-runtime-int,
  google-runtime-operator,
  google-upgrade-googletest-case,

  misc-*,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,

  modernize-*,
  -modernize-use-default-member-init,
  -modernize-use-trailing-return-type,

  performance-*,

  portability-*,

  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-math-missing-parentheses,
  -readability-named-parameter,
  -readability-qualified-auto

CheckOptions:
  readability-function-cognitive-complexity.Threshold: 40

  readability-identifier-naming.DefaultCase: lower_case

  readability-identifier-naming.NamespaceCase: lower_case

  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase

  readability-identifier-naming.EnumConstantCase: UPPER_CASE

  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.MethodCase: CamelCase

  readability-identifier-naming.VariableCase: snake_case
  readability-identifier-naming.LocalVariableCase: snake_case
  readability-identifier-naming.ParameterCase: snake_case

  readability-identifier-naming.MemberCase: snake_case
  readability-identifier-naming.MemberSuffix: '_'

  readability-identifier-naming.GlobalVariableCase: UPPER_CASE
  readability-identifier-naming.StaticVariableCase: UPPER_CASE
  readability-identifier-naming.ClassConstantCase: UPPER_CASE
  readability-identifier-naming.GlobalConstantCase: UPPER_CASE
  readability-identifier-naming.StaticConstantCase: UPPER_CASE
  readability-identifier-naming.ConstexprVariableCase: UPPER_CASE
  readability-identifier-naming.ClassConstexprCase: UPPER_CASE
