{
  "name": "valid-inference-test",
  "version": "1.0.0",
  "gnus_spec_version": 1.0,
  "inputs": [
    {
      "name": "testInput",
      "source_uri_param": "file://processing_datatypes/float_input.bin",
      "type": "float",
      "dimensions": {
        "width": 16,
        "block_len": 16,
        "chunk_stride": 16
      },
      "format": "FLOAT32"
    }
  ],
  "outputs": [
    {
      "name": "testOutput",
      "source_uri_param": "file://processing_datatypes/float_output.raw",
      "type": "tensor"
    }
  ],
  "passes": [
    {
      "name": "valid_inference",
      "type": "inference",
      "model": {
        "source_uri_param": "file://processing_datatypes/float_model.mnn",
        "format": "MNN",
        "batch_size": 1,
        "input_nodes": [
          {
            "name": "input",
            "type": "tensor",
            "source": "input:testInput",
            "shape": [1, 16]
          }
        ],
        "output_nodes": [
          {
            "name": "output",
            "type": "tensor",
            "target": "output:testOutput",
            "shape": [1, 16]
          }
        ]
      }
    }
  ]
}
