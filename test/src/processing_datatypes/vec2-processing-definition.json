{
  "name": "vec2-tiny-test",
  "version": "1.0.0",
  "description": "A test processing definition for vec2 input using a tiny Conv1D model",
  "tags": ["vec2", "vector", "test"],
  "inputs": [
    {
      "name": "inputVec2",
      "source_uri_param": "file://processing_datatypes/vec2_input.raw",
      "type": "vec2",
      "description": "Input vec2 array (X, Y components)",
      "dimensions": {
        "width": 16
      },
      "format": "float32"
    }
  ],
  "outputs": [
    {
      "name": "vec2Output",
      "source_uri_param": "file://processing_datatypes/vec2_output.raw",
      "type": "float",
      "description": "Output tensor from vec2 model"
    }
  ],
  "parameters": [
    {
      "name": "modelPath",
      "type": "string",
      "required": true,
      "default": "file://processing_datatypes/vec2_tiny.mnn",
      "description": "URI to the vec2 MNN model"
    }
  ],
  "passes": [
    {
      "name": "vec2_inference",
      "type": "inference",
      "model": {
        "source_uri_param": "file://processing_datatypes/vec2_tiny.mnn",
        "input_nodes": [
          {
            "source": "input:inputVec2"
          }
        ],
        "output_nodes": [
          {
            "target": "output:vec2Output"
          }
        ]
      }
    }
  ],
  "test_case": "vec2_datatype"
}
